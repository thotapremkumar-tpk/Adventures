--- !u!114 &324797988
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 324797987}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0962fce3724cb4b089346cfbebdbf2cd, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Adventures.LevelIntro
  levelName: "LEVEL 2 \u2014 THE PROVERB LABYRINTH"
  pages:
  - title: The Proverb Labyrinth
    body: "Past the Eclipse Door the tunnel opens into a maze of narrow stone halls. Carved above the entrance is a proverb. The Keeper wrote that it is the ONLY safe way through \u2014 the wrong paths collapse into the pit."
  - title: The Keeper's Proverb
    body: "\"Follow the SUN that RISES, and never the one that SETS \u2014 the sinking sun leads only to the dark below.\n\nWhere the SERPENT coils THREE times, the WATER will speak. Count well: one coil too few or too many, and the earth will swallow you.\n\nWhere the OWL keeps watch, turn your BACK upon its eyes.\n\nAnd when the sun rises once more, the gold of the kings is near.\"\n\n(Press TAB at any time to read this again.)"
  objective: Solve the labyrinth using the proverb (TAB to re-read it)
  grantIfMissing: []
  rereadWithTab: 1
  ambientRumble: 0.5
  drips: 1
  nextScene: 00_Intro
  mapTexture: {fileID: 2800000, guid: dd75a031024544f07b7cf68e8a77bf60, type: 3}
  mapLegend: "THE MAP OF THE OLD KINGS\n\n\u2022 The house \u2014 your study, where the journey begins.\n\u2022 Red trail \u2014 the road to the Old Cave in the mountains.\n\u2022 Beneath the cave \u2014 a great shaft into the deep.\n\u2022 The wheel \u2014 the Tower of Turning Fans. Cross it to the top.\n\u2022 The grid \u2014 the Labyrinth. The proverb is the only guide.\n\u2022 The red X \u2014 the treasure vault.\n\nMargin note: \"Sun and Moon together open the way.\"\n\nPress M any time to view this map.  (Enter to close)"
