  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2066832259}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e93b5c438951e4c5a8298d20005af660, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Adventures.PickupItem
  prompt: Examine the old map
  range: 2.6
  itemIds:
  - map
  - key_sun
  toast: 'Got: Old Map + Sun Key'
  story:
  - title: The Map of the Old Kings
    body: 'The parchment is older than any you have held. In faded ink the last Keeper of the Old Kings wrote:


      "Our gold lies beneath the Old Cave, where the mountain swallows the light. Five trials guard it. Only one who carries the Sun and the Moon may reach it."'
  - title: The Sun Key
    body: 'Wrapped inside the map is a heavy golden key shaped like a rising sun.


      On its back is an inscription: "I am half of the way. Find my sister, the Moon, in the house of turning winds."


      You pack your big torch. It is time to go.'
  mapTexture: {fileID: 2800000, guid: dd75a031024544f07b7cf68e8a77bf60, type: 3}
  mapLegend: "THE MAP OF THE OLD KINGS\n\n\u2022 The house \u2014 your study, where the journey begins.\n\u2022 Red trail \u2014 the road to the Old Cave in the mountains.\n\u2022 Beneath the cave \u2014 a great shaft into the deep.\n\u2022 The wheel \u2014 the Tower of Turning Fans. Cross it to the top.\n\u2022 The grid \u2014 the Labyrinth. The proverb is the only guide.\n\u2022 The red X \u2014 the treasure vault.\n\nMargin note: \"Sun and Moon together open the way.\"\n\nPress M any time to view this map.  (Enter to close)"
  newObjective: "Travel to the Old Cave \u2014 leave through the north door"
