  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0962fce3724cb4b089346cfbebdbf2cd, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Adventures.LevelIntro
  levelName: THE OLD CAVE
  pages:
  - title: The Old Cave
    body: 'Three days of travel bring you to the mountain from the map. The Old Cave yawns in front of you, completely dark.


      You light your big torch and step inside.'
  objective: "Enter the Old Cave (your torch lights the way \u2014 F toggles it)"
  grantIfMissing:
  - map
  - key_sun
  rereadWithTab: 0
  ambientRumble: 0.6
  drips: 1
  nextScene: 02_Level1_FanTower
  mapTexture: {fileID: 2800000, guid: dd75a031024544f07b7cf68e8a77bf60, type: 3}
  mapLegend: "THE MAP OF THE OLD KINGS\n\n\u2022 The house \u2014 your study, where the journey begins.\n\u2022 Red trail \u2014 the road to the Old Cave in the mountains.\n\u2022 Beneath the cave \u2014 a great shaft into the deep.\n\u2022 The wheel \u2014 the Tower of Turning Fans. Cross it to the top.\n\u2022 The grid \u2014 the Labyrinth. The proverb is the only guide.\n\u2022 The red X \u2014 the treasure vault.\n\nMargin note: \"Sun and Moon together open the way.\"\n\nPress M any time to view this map.  (Enter to close)"
